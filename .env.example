APP_NAME=In-Game Purchases API
APP_ENV=dev
APP_HOST=0.0.0.0
APP_PORT=8000
API_V1_PREFIX=/api/v1

DATABASE_URL=postgresql+asyncpg://app:app@postgres:5432/game_store
REDIS_URL=redis://redis:6379/0
REDIS_KEY_PREFIX=igs:mvp
PURCHASE_RESERVE_TTL_SECONDS=30

JWT_SECRET=change-me-in-production
JWT_ISSUER=in-game-purchases-api
JWT_AUDIENCE=in-game-purchases-client
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
PASSWORD_HASH_ITERATIONS=390000
REFUND_WINDOW_MINUTES=120
ALLOW_ADMIN_REFUND_AFTER_WINDOW=true
REQUIRE_INVENTORY_FOR_REFUND=true
TOKEN_CLOCK_SKEW_SECONDS=30
MAX_TOKEN_BYTES=4096

SQL_ECHO=false
